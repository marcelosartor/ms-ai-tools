{
  "backend-node": {
    "paths": ["**/*.controller.*", "**/*.service.*", "**/*.module.ts", "**/*.guard.*",
              "**/*.interceptor.*", "**/*.dto.ts", "**/*.entity.ts", "**/*.resolver.ts",
              "**/*.gateway.ts", "**/*.pipe.ts", "**/*.filter.ts", "**/*.strategy.ts",
              "**/routes/**", "**/*.route.*", "**/*.router.*", "**/middleware/**",
              "**/server.[tj]s", "**/app.[tj]s", "**/handlers/**", "**/plugins/**"],
    "deps": ["express", "fastify", "@nestjs/core", "koa", "hono", "@hapi/hapi"],
    "content": ["app\\.(get|post|put|patch|delete|use)\\(", "fastify\\.(get|post|register)\\(",
                "@Controller\\(", "createServer\\(", "router\\.(get|post|put|patch|delete)\\("],
    "variants": {
      "express": {"deps": ["express"]},
      "fastify": {"deps": ["fastify", "@nestjs/platform-fastify"]},
      "nest": {"deps": ["@nestjs/core"]},
      "koa": {"deps": ["koa"]}
    }
  },
  "frontend-vue": {
    "paths": ["**/*.vue"],
    "deps": ["vue", "quasar", "vuetify"]
  },
  "frontend-react": {
    "paths": ["**/*.tsx", "**/*.jsx"],
    "deps": ["react"]
  },
  "database-postgres-pgvector": {
    "exclusive_group": "database",
    "paths": ["**/migrations/**", "**/migration/**", "**/*.sql", "**/schema.prisma", "**/drizzle/**"],
    "deps": ["pg", "postgres", "pg-promise", "pgvector", "@electric-sql/pglite"],
    "manifest": {"files": ["pom.xml", "build.gradle.kts", "build.gradle", "libs.versions.toml"],
                 "pattern": "org\\.postgresql|r2dbc-postgresql",
                 "ext": [".java", ".kt"]},
    "content": ["vector\\(", "<=>", "<->", "<#>", "embedding", "pgvector", "CREATE INDEX", "ALTER TABLE"]
  },
  "database-mssql": {
    "exclusive_group": "database",
    "paths": ["**/*.sql", "**/*.sqlproj", "**/*.dacpac", "**/db/migration/**"],
    "deps": ["mssql", "tedious", "@azure/msnodesqlv8"],
    "manifest": {"files": ["pom.xml", "build.gradle.kts", "build.gradle", "libs.versions.toml"],
                 "pattern": "mssql-jdbc|sqlserver|r2dbc-mssql",
                 "ext": [".java", ".kt"]},
    "content": ["NVARCHAR", "^GO\\s*$", "\\bdbo\\.", "WITH \\(NOLOCK\\)", "DATETIME2",
                "IDENTITY\\(", "\\bTOP \\(", "OFFSET .* ROWS FETCH", "sp_executesql",
                "MERGE .* USING", "SCOPE_IDENTITY", "UNIQUEIDENTIFIER", "NEWSEQUENTIALID"]
  },
  "database-sqlite-android": {
    "exclusive_group": "database",
    "paths": ["**/schemas/*/*.json", "**/assets/**/*.db"],
    "manifest": {"files": ["build.gradle.kts", "build.gradle", "libs.versions.toml"],
                 "pattern": "androidx\\.room|room-runtime|room-ktx|room-compiler|androidx\\.sqlite|sqlite-bundled|sqlcipher",
                 "ext": [".kt", ".java"]},
    "content": ["@Database\\(", "@Dao\\b", "@Entity\\(tableName", "RoomDatabase", "SQLiteOpenHelper",
                "SQLiteDatabase", "SupportSQLiteDatabase", "Migration\\([0-9]+, ?[0-9]+\\)",
                "execSQL\\(", "rawQuery\\(", "@Upsert", "PagingSource"]
  },
  "database-mongodb": {
    "exclusive_group": "database",
    "paths": ["**/*.schema.ts", "**/schemas/**/*.ts", "**/migrations-mongo/**", "**/mongock/**"],
    "deps": ["mongodb", "mongoose", "@nestjs/mongoose", "@typegoose/typegoose", "migrate-mongo", "mongodb-memory-server"],
    "manifest": {"files": ["pom.xml", "build.gradle.kts", "build.gradle", "libs.versions.toml"],
                 "pattern": "spring-boot-starter-data-mongodb|mongodb-driver|mongock",
                 "ext": [".java", ".kt"]},
    "content": ["@Schema\\(", "mongoose\\.", "\\.aggregate\\(\\[", "\\$lookup", "\\$match", "ObjectId\\(",
                "@Document\\(", "MongoRepository", "MongoTemplate", "db\\.collection\\(",
                "findOneAndUpdate", "updateMany\\(", "bulkWrite\\(", "\\$vectorSearch"]
  },
  "common": {"always": true},
  "ci-infra": {
    "paths": [".github/workflows/**", "**/Dockerfile*", "**/docker-compose*.y*ml",
              "**/*.tf", "**/k8s/**", "**/helm/**", "**/nginx*.conf", "**/Procfile",
              "**/.gitlab-ci.yml", "**/Jenkinsfile", "**/fly.toml", "**/vercel.json"]
  },
  "llm-integration": {
    "paths": ["**/prompts/**", "**/*prompt*", "**/*.prompt.*", "**/agents/**", "**/rag/**"],
    "deps": ["openai", "@anthropic-ai/sdk", "ai", "@ai-sdk/openai", "@ai-sdk/anthropic",
             "langchain", "@langchain/core", "llamaindex", "@google/generative-ai",
             "ollama", "cohere-ai", "@mistralai/mistralai"],
    "manifest": {"files": ["pom.xml", "build.gradle", "build.gradle.kts", "libs.versions.toml"],
                 "pattern": "spring-ai|langchain4j|anthropic|openai|generativeai",
                 "ext": [".java", ".kt"]},
    "content": ["chat\\.completions", "messages\\.create", "generateText\\(", "streamText\\(",
                "embeddings?\\.create", "ChatClient", "EmbeddingModel", "GenerativeModel",
                "system_prompt", "systemPrompt", "tool_use", "function_call"]
  },
  "android-kotlin": {
    "paths": ["**/AndroidManifest.xml", "**/src/*/res/**", "**/proguard-rules.pro",
              "**/network_security_config.xml", "**/*.kts"],
    "paths_require_manifest": true,
    "manifest": {"files": ["build.gradle.kts", "build.gradle"],
                 "pattern": "com\\.android\\.(application|library)|android \\{|androidx",
                 "ext": [".kt", ".java", ".xml"]},
    "content": ["androidx\\.", "android\\.(os|content|app|view|widget)\\.", "@Composable",
                "@HiltViewModel", "@AndroidEntryPoint", "@Dao", "@Entity\\(tableName"],
    "variants": {
      "compose": {"manifest": {"files": ["build.gradle.kts", "build.gradle", "libs.versions.toml"], "pattern": "androidx\\.compose|compose-bom|buildFeatures.*compose|compose = true", "ext": [".kt"]}, "content": ["@Composable"]},
      "views": {"paths": ["**/res/layout/**"], "content": ["ViewBinding", "findViewById", "RecyclerView", "Fragment\\("]},
      "room": {"manifest": {"files": ["build.gradle.kts", "build.gradle", "libs.versions.toml"], "pattern": "androidx\\.room|room-runtime", "ext": [".kt"]}, "content": ["@Dao", "@Database\\(", "RoomDatabase"]},
      "hilt": {"content": ["@HiltViewModel", "@AndroidEntryPoint", "@InstallIn"]}
    }
  },
  "java-spring": {
    "paths": ["**/*.java", "**/src/main/resources/application*.y*ml",
              "**/src/main/resources/application*.properties", "**/pom.xml",
              "**/src/main/resources/db/migration/**", "**/src/main/resources/db/changelog/**"],
    "manifest": {"files": ["pom.xml", "build.gradle.kts", "build.gradle", "libs.versions.toml"],
                 "pattern": "spring-boot|springframework",
                 "ext": [".java", ".kt"]},
    "content": ["@SpringBootApplication", "@RestController", "@Service\\b", "@Repository\\b",
                "@Transactional", "org\\.springframework", "jakarta\\.persistence"],
    "variants": {
      "jpa": {"manifest": {"files": ["pom.xml", "build.gradle.kts", "build.gradle", "libs.versions.toml"], "pattern": "spring-boot-starter-data-jpa|hibernate", "ext": [".java", ".kt"]}, "content": ["jakarta\\.persistence", "JpaRepository"]},
      "security": {"manifest": {"files": ["pom.xml", "build.gradle.kts", "build.gradle", "libs.versions.toml"], "pattern": "spring-boot-starter-security|spring-security", "ext": [".java", ".kt"]}, "content": ["@PreAuthorize", "SecurityFilterChain", "HttpSecurity"]},
      "webflux": {"manifest": {"files": ["pom.xml", "build.gradle.kts", "build.gradle", "libs.versions.toml"], "pattern": "spring-boot-starter-webflux", "ext": [".java", ".kt"]}, "content": ["Mono<", "Flux<"]},
      "messaging": {"manifest": {"files": ["pom.xml", "build.gradle.kts", "build.gradle", "libs.versions.toml"], "pattern": "spring-kafka|spring-boot-starter-amqp|spring-cloud-stream", "ext": [".java", ".kt"]}, "content": ["@KafkaListener", "@RabbitListener"]}
    }
  }
}
