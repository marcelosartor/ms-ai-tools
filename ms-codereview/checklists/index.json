{
  "backend-node": {
    "paths": ["**/*.controller.*", "**/*.service.*", "**/*.module.ts", "**/*.guard.*",
              "**/*.interceptor.*", "**/*.dto.ts", "**/*.entity.ts", "**/*.resolver.ts",
              "**/*.gateway.ts", "**/*.pipe.ts", "**/*.filter.ts", "**/*.strategy.ts",
              "**/routes/**", "**/*.route.*", "**/*.router.*", "**/middleware/**",
              "**/server.[tj]s", "**/app.[tj]s", "**/handlers/**", "**/plugins/**"],
    "deps": ["express", "fastify", "@nestjs/core", "koa", "hono", "@hapi/hapi"],
    "content": ["app\\.(get|post|put|patch|delete|use)\\(", "fastify\\.(get|post|register)\\(",
                "@Controller\\(", "createServer\\(", "router\\.(get|post|put|patch|delete)\\("],
    "variants": {
      "express": {"deps": ["express"]},
      "fastify": {"deps": ["fastify", "@nestjs/platform-fastify"]},
      "nest": {"deps": ["@nestjs/core"]},
      "koa": {"deps": ["koa"]}
    }
  },
  "frontend-vue": {
    "paths": ["**/*.vue"],
    "deps": ["vue", "quasar", "vuetify"]
  },
  "frontend-react": {
    "paths": ["**/*.tsx", "**/*.jsx"],
    "deps": ["react"]
  },
  "database-postgres-pgvector": {
    "paths": ["**/migrations/**", "**/migration/**", "**/*.sql", "**/schema.prisma", "**/drizzle/**"],
    "content": ["vector\\(", "<=>", "<->", "<#>", "embedding", "pgvector", "CREATE INDEX", "ALTER TABLE"]
  },
  "common": {"always": true},
  "ci-infra": {
    "paths": [".github/workflows/**", "**/Dockerfile*", "**/docker-compose*.y*ml",
              "**/*.tf", "**/k8s/**", "**/helm/**", "**/nginx*.conf", "**/Procfile",
              "**/.gitlab-ci.yml", "**/Jenkinsfile", "**/fly.toml", "**/vercel.json"]
  },
  "llm-integration": {
    "paths": ["**/prompts/**", "**/*prompt*", "**/*.prompt.*", "**/agents/**", "**/rag/**"],
    "deps": ["openai", "@anthropic-ai/sdk", "ai", "@ai-sdk/openai", "@ai-sdk/anthropic",
             "langchain", "@langchain/core", "llamaindex", "@google/generative-ai",
             "ollama", "cohere-ai", "@mistralai/mistralai"],
    "manifest": {"files": ["pom.xml", "build.gradle", "build.gradle.kts", "libs.versions.toml"],
                 "pattern": "spring-ai|langchain4j|anthropic|openai|generativeai",
                 "ext": [".java", ".kt"]},
    "content": ["chat\\.completions", "messages\\.create", "generateText\\(", "streamText\\(",
                "embeddings?\\.create", "ChatClient", "EmbeddingModel", "GenerativeModel",
                "system_prompt", "systemPrompt", "tool_use", "function_call"]
  }
}
